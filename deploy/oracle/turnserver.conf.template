# coturn para o Ponte — gerado pelo install.sh. Não edite o segredo à mão.
listening-port=3478
fingerprint
use-auth-secret
static-auth-secret=__TURN_SECRET__
realm=__PONTE_DOMAIN__
# A VM da Oracle tem IP privado com NAT 1:1 para o IP público.
external-ip=__PUBLIC_IP__/__PRIVATE_IP__
min-port=49160
max-port=49200
no-cli
no-tls
no-dtls
no-multicast-peers
# Não retransmitir para redes internas (evita usar o TURN para alcançar a rede da nuvem).
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
total-quota=100
user-quota=12
stale-nonce=600
log-file=stdout
